---
import CoverageMap from '../components/Map.astro';
import MetricCards from '../components/MetricCards.astro';
import RankingTable from '../components/RankingTable.astro';
import SiteCard from '../components/SiteCard.astro';
import Layout from '../layouts/Layout.astro';
import { loadMunicipalities, loadSites } from '../lib/data';
import { calculateNationalMetrics, calculatePrefectureMetrics } from '../lib/metrics';
import { ZENKOKU_GIKAI_URL } from '../lib/site';

const sites = loadSites('data/sites.yaml');
const municipalities = loadMunicipalities('data/municipalities.csv');
const national = calculateNationalMetrics(sites, municipalities);
const prefectures = calculatePrefectureMetrics(sites, municipalities);
const assemblies = new Map(municipalities.map((m) => [m.code5, m]));

// Newest added_on first; among equal dates, entries later in sites.yaml count as newer.
const recentSites = sites
  .map((site, index) => ({ site, index }))
  .sort((a, b) => b.site.addedOn.localeCompare(a.site.addedOn) || b.index - a.index)
  .slice(0, 5)
  .map(({ site }) => site);
---

<Layout>
  <section class="hero">
    <h1>全国の「みらい議会」マップ・まとめ</h1>
    <p>
      全国各地の地方議会ごとに立ち上がった「みらい議会」サイトを一覧でまとめ、開設状況と人口カバー率を可視化しています。
    </p>
  </section>

  <h2 class="visually-hidden">全国の状況</h2>
  <MetricCards metrics={national} />

  <div class="map-wrap">
    <CoverageMap prefectures={prefectures} />
  </div>

  <h2 class="section-title" id="ranking">都道府県ランキング</h2>
  <p class="section-lead">
    人口カバー率の高い順です。同率の場合は自治体数カバー率、都道府県コードの順に並べています。
  </p>
  <RankingTable prefectures={prefectures} />

  <h2 class="section-title">最近追加されたサイト</h2>
  <ul class="recent-grid">
    {
      recentSites.map((site) => (
        <li>
          <SiteCard site={site} assembly={assemblies.get(site.assemblyCode5)} />
        </li>
      ))
    }
  </ul>
  <p class="all-sites-link">
    <a href="/sites">すべてのみらい議会掲載サイト・まとめ一覧を見る →</a>
  </p>

  <section class="related-section">
    <h2 class="section-title">関連プロジェクト</h2>
    <div class="card related-card">
      <div class="related-header">
        <span class="badge badge-platform">外部プラットフォーム</span>
        <h3 class="related-title">
          <a href={ZENKOKU_GIKAI_URL} target="_blank" rel="noopener">
            みらい議会＠全国地方議会<span aria-hidden="true"> ↗</span>
          </a>
        </h3>
      </div>
      <p class="related-desc">
        全国の地方議会（都道府県・市区町村議会）の議案を集約し、AIによる解説やインタビューを通じて横断的に閲覧・探索できる有志のシビックテックプロジェクトです。
      </p>
      <div class="related-meta">
        <a href={ZENKOKU_GIKAI_URL} class="related-link" target="_blank" rel="noopener">
          mirai-gikai-zenkoku.vercel.app<span aria-hidden="true"> ↗</span>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero h1 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.5rem, 4vw, 2.1rem);
  }

  .hero p {
    margin: 0 0 1.5rem;
    color: var(--color-muted);
    max-width: 60ch;
  }

  .map-wrap {
    margin-top: 1.5rem;
  }

  .section-lead {
    margin: -0.5rem 0 1rem;
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .recent-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 12px;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }

  .all-sites-link {
    margin: 0 0 2rem;
  }

  .related-section {
    margin-top: 2.5rem;
  }

  .related-card {
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border-left: 4px solid var(--color-accent);
  }

  .related-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .badge-platform {
    background: var(--color-info-bg);
    color: var(--color-info-text);
  }

  .related-title {
    margin: 0;
    font-size: 1.1rem;
  }

  .related-title a {
    color: var(--color-text);
    text-decoration: none;
  }

  .related-title a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .related-desc {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-muted);
    line-height: 1.6;
    max-width: 75ch;
  }

  .related-meta {
    font-size: 0.85rem;
    margin-top: 0.25rem;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
